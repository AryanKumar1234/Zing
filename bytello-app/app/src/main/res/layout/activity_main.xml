<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bytello setup"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Step 1: the device name. -->
        <LinearLayout
            android:id="@+id/stepName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Type the name this phone answers to. Zing sends its commands to that name. After this screen the app runs in the background and disappears from the launcher."
                android:textSize="14sp" />

            <EditText
                android:id="@+id/deviceName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:hint="Device name (e.g. oppo)"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1" />

            <Button
                android:id="@+id/btnEnable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Turn on" />
        </LinearLayout>

        <!-- Step 2: permissions. Stays open as long as the user needs; nothing times out. -->
        <LinearLayout
            android:id="@+id/stepPerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Give the app these permissions, then tap Done. Take as long as you need — the screen will not close by itself."
                android:textSize="14sp" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnBackground"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Allow running in background (battery)" />

            <Button
                android:id="@+id/btnAppSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Open app settings (auto-start / background activity)" />

            <Button
                android:id="@+id/btnDnd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Allow sound changes (Do Not Disturb access)" />

            <Button
                android:id="@+id/btnDone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Done — hide from launcher" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
